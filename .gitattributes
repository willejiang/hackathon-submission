# Order matters: gitattributes applies the LAST matching rule, so the catch-all
# goes first and the specific overrides after it.
* text=auto

# STEP is a text format but it is a submission artifact: its bytes must survive a
# checkout unchanged, so git must not normalise its line endings.
*.stp -text
*.step -text
*.stl binary

# Reference renders and anything the pipeline rasterises.
*.png binary
*.jpg binary

# The harness carries skills up to a byte budget; CRLF costs one unit per line, so
# these must stay LF in every checkout, not only in this one.
dsh-plugin/skills/**/*.md text eol=lf
